# Copy to .env and edit. Every value here has a safe default except the ones marked REQUIRED.

# ---- REQUIRED: secrets ----------------------------------------------------
# Generate each with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
KEEL_API_TOKEN=            # dashboard + API login (full control)
KEEL_OBS_PASSWORD=         # obs-websocket password (internal only)
# The stream key your phone uses. Must be live/ followed by 16+ letters, numbers, - or _
KEEL_INGEST_PATH=live/CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- Optional: a second token for moderators -------------------------------
# Can switch scenes and sources from the dashboard or app. Cannot stop the broadcast or change settings.
KEEL_MOD_TOKEN=

# ---- Backup ingest (automatic failover) -----------------------------------
# A second encoder (another phone, a Belabox, a second SIM app) publishes here. If the primary fails,
# viewers stay LIVE on the backup instead of seeing BRB. Default: KEEL_INGEST_PATH + "-backup".
# Set to "off" to disable.
KEEL_BACKUP_INGEST_PATH=

# ---- Where the finished broadcast goes -----------------------------------
# relay (default): OBS sends to Keel's local relay, which pushes to every destination below with its own
# reconnects, and shows BRB on every platform if OBS crashes (crash shield).
# direct: OBS streams straight to the first destination (the original v0.1 path).
KEEL_OUTPUT_MODE=relay

# Destinations: "Name=full-url-with-key", separated by ";" . rtmp://, rtmps:// and srt:// work.
# KEEL_DESTINATIONS=Twitch=rtmp://live.twitch.tv/app/live_xxx;Kick=rtmps://fa723fc1b171.global-contribute.live-video.net/app/sk_xxx;YouTube=rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx
KEEL_DESTINATIONS=

# Or the single-destination form (still supported). Twitch: pick the closest ingest from
# https://help.twitch.tv/s/twitch-ingest-recommendation
KEEL_RTMP_URL=rtmp://live.twitch.tv/app
KEEL_STREAM_KEY=

KEEL_SHIELD_DELAY_S=3      # seconds without the OBS program before every platform gets the BRB screen
KEEL_AUTO_RESTART=true     # restart a broadcast that stops without anyone pressing stop

# ---- What viewers should see on your server's address ---------------------
# The public hostname or IP of the machine running this stack. Used to print
# the URLs your phone app needs on the dashboard.
KEEL_PUBLIC_HOST=localhost
# Where the plain HTTP dashboard listens. Use 127.0.0.1 once HTTPS (profile tls) is on.
KEEL_DASHBOARD_BIND=0.0.0.0

# ---- Encoding and latency ---------------------------------------------------
KEEL_ENCODER=x264          # x264 (CPU, works anywhere) or nvenc (NVIDIA GPU, see docs/GPU.md)
KEEL_RESOLUTION=1080p      # 720p, 1080p or 1440p; OBS and the controller both read this
KEEL_FPS=30                # 30 or 60; OBS and the controller both read this
KEEL_BITRATE_KBPS=6000
KEEL_X264_PRESET=veryfast  # faster presets use less CPU (superfast, ultrafast), slower look better
KEEL_INPUT_BUFFER_MB=1     # OBS network buffer for the phone feed. 0 to 1 = lowest latency, 2+ = more jitter tolerance

# ---- Switching behaviour (all of these can also be changed live from the dashboard) ----
KEEL_LOW_KBPS=800          # below this the LOW SIGNAL scene is used
KEEL_OFFLINE_KBPS=50       # below this the feed counts as gone, BRB
KEEL_DEGRADE_OFFLINE_S=2   # seconds of dead feed before BRB
KEEL_DEGRADE_LOW_S=3       # seconds of weak feed before LOW SIGNAL
KEEL_RECOVER_S=5           # seconds of healthy feed before going back to LIVE
KEEL_MAX_DROP_PCT=2        # SRT: % of packets arriving too late to show. Above this counts as weak. 0 = off
KEEL_MAX_LOSS_PCT=20       # SRT: % of packets lost before retransmission. Above this counts as weak. 0 = off

# ---- Crew alerts (optional) ---------------------------------------------------
# A Discord or Slack incoming webhook URL. Keel posts drops, recoveries, failovers, platform reconnects
# and crash shield events, throttled so a flapping link cannot spam the channel.
KEEL_NOTIFY_WEBHOOK=

# ---- Twitch chat control (optional) --------------------------------------
# Create a bot account (or use your own), get a token at https://twitchtokengenerator.com (scope chat:read chat:edit)
KEEL_TWITCH_CHANNEL=
KEEL_TWITCH_BOT_NAME=
KEEL_TWITCH_TOKEN=
KEEL_TWITCH_ALLOWED=       # extra usernames allowed to run commands, comma separated (mods and broadcaster always can)

# ---- Auto shutdown --------------------------------------------------------
# After this many idle minutes (no feed, not broadcasting, nobody on the dashboard) Keel acts.
KEEL_IDLE_MINUTES=15
KEEL_IDLE_ACTION=log       # log | exit | webhook   (webhook POSTs to KEEL_IDLE_WEBHOOK so your orchestrator can stop the server)
KEEL_IDLE_WEBHOOK=

# ---- Prebuilt images (optional, faster first boot) ----------------------------
# KEEL_IMAGE_PREFIX=ghcr.io/<owner>/keel
# KEEL_IMAGE_TAG=latest
