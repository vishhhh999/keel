# Copy to .env and edit. Every value here has a safe default except the ones marked REQUIRED.

# ---- REQUIRED: secrets ----------------------------------------------------
# Generate each with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
KEEL_API_TOKEN=            # dashboard + API login
KEEL_OBS_PASSWORD=         # obs-websocket password (internal only)
# The stream key your phone uses. Must be live/ followed by 16+ letters, numbers, - or _
KEEL_INGEST_PATH=live/CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- Where the finished broadcast goes -----------------------------------
# Twitch: rtmp://live.twitch.tv/app  (pick the closest ingest from https://help.twitch.tv/s/twitch-ingest-recommendation)
KEEL_RTMP_URL=rtmp://live.twitch.tv/app
KEEL_STREAM_KEY=

# ---- What viewers should see on your server's address ---------------------
# The public hostname or IP of the machine running this stack. Used to print
# the URLs your phone app needs on the dashboard.
KEEL_PUBLIC_HOST=localhost
# Where the plain HTTP dashboard listens. Use 127.0.0.1 once HTTPS (profile tls) is on.
KEEL_DASHBOARD_BIND=0.0.0.0

# ---- Encoding -------------------------------------------------------------
KEEL_ENCODER=x264          # x264 (CPU, works anywhere) or nvenc (NVIDIA GPU, see docs/GPU.md)
KEEL_BITRATE_KBPS=6000
KEEL_FPS=30                # 30 or 60; OBS and the controller both read this

# ---- Switching behaviour (defaults are sensible for 4-8 Mbps IRL feeds) ----
KEEL_LOW_KBPS=800          # below this the LOW SIGNAL scene is used
KEEL_OFFLINE_KBPS=50       # below this the feed counts as gone, BRB
KEEL_DEGRADE_OFFLINE_S=2   # seconds of dead feed before BRB
KEEL_DEGRADE_LOW_S=3       # seconds of low bitrate before LOW SIGNAL
KEEL_RECOVER_S=5           # seconds of healthy feed before going back to LIVE

# ---- Twitch chat control (optional) --------------------------------------
# Create a bot account (or use your own), get a token at https://twitchtokengenerator.com (scope chat:read chat:edit)
KEEL_TWITCH_CHANNEL=
KEEL_TWITCH_BOT_NAME=
KEEL_TWITCH_TOKEN=
KEEL_TWITCH_ALLOWED=       # extra usernames allowed to run commands, comma separated (mods and broadcaster always can)

# ---- Auto shutdown --------------------------------------------------------
# After this many idle minutes (no feed, not broadcasting, nobody on the dashboard) Keel acts.
KEEL_IDLE_MINUTES=15
KEEL_IDLE_ACTION=log       # log | exit | webhook   (webhook POSTs to KEEL_IDLE_WEBHOOK so your orchestrator can stop the server)
KEEL_IDLE_WEBHOOK=
